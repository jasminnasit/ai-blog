---
// BlogPostLayout.astro
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagBadge from '../components/TagBadge.astro';

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      heroImage?: string;
      tags: string[];
      category?: string;
      author?: string;
      authorAvatar?: string;
      readingTime?: string;
    };
  };
  headings: Array<{ depth: number; slug: string; text: string }>;
  readingTime?: string;
  prevPost?: any;
  nextPost?: any;
}

const { post, headings, readingTime = '5 min read', prevPost, nextPost } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(post.data.pubDate));

const heroImage = post.data.heroImage || 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?auto=format&fit=crop&w=1200&q=80';

// Structured data for SEO (BlogPosting)
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: heroImage,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author || 'Jasmin Nasit',
    url: 'https://github.com/jasminnasit',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Nexus AI',
    logo: {
      '@type': 'ImageObject',
      url: 'https://jasminnasit.github.io/ai-blog/favicon.svg',
    },
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={heroImage}
  articleDate={post.data.pubDate.toISOString()}
  author={post.data.author || 'Jasmin Nasit'}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-6 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <a href={`${base}/`} class="hover:text-purple-600 dark:hover:text-purple-400">Home</a>
      <span>/</span>
      <a href={`${base}/blog`} class="hover:text-purple-600 dark:hover:text-purple-400">Articles</a>
      <span>/</span>
      <span class="truncate max-w-[200px] sm:max-w-md text-slate-800 dark:text-slate-200">{post.data.title}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      {
        post.data.category && (
          <span class="inline-block rounded-full bg-purple-100 dark:bg-purple-950/60 px-3 py-1 text-xs font-semibold text-purple-700 dark:text-purple-300">
            {post.data.category}
          </span>
        )
      }

      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl lg:text-5xl leading-tight">
        {post.data.title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {post.data.description}
      </p>

      <!-- Author & Meta bar -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-2">
          <div class="h-8 w-8 rounded-full bg-gradient-to-tr from-purple-600 to-indigo-600 flex items-center justify-center text-white font-bold text-xs shadow">
            JN
          </div>
          <span class="font-medium text-slate-800 dark:text-slate-200">{post.data.author || 'Jasmin Nasit'}</span>
        </div>
        <span>•</span>
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span class="flex items-center gap-1">
          <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {readingTime}
        </span>
      </div>
    </header>

    <!-- Hero Image -->
    <div class="mb-12 overflow-hidden rounded-3xl border border-slate-200/80 bg-slate-100 shadow-xl dark:border-slate-800 dark:bg-slate-900">
      <img
        src={heroImage}
        alt={post.data.title}
        class="aspect-[21/9] w-full object-cover max-h-[480px]"
      />
    </div>

    <!-- Article Content + Sticky Sidebar Grid -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- Main Content Prose -->
      <div class="lg:col-span-8">
        <div class="prose prose-slate lg:prose-lg dark:prose-invert max-w-none">
          <slot />
        </div>

        <!-- Tags at bottom of article -->
        <div class="mt-12 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-6 dark:border-slate-800">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Tags:</span>
          {post.data.tags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>

        <!-- Social Share Bar -->
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/80 bg-white p-4 dark:border-slate-800/80 dark:bg-slate-900/40">
          <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Share this article:</span>
          <div class="flex items-center gap-2">
            <!-- Share on X (Twitter) -->
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition"
            >
              X / Twitter
            </a>

            <!-- Share on LinkedIn -->
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition"
            >
              LinkedIn
            </a>

            <!-- Copy Link Button -->
            <button
              id="copy-link-btn"
              type="button"
              class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition"
            >
              Copy Link
            </button>
          </div>
        </div>

        <!-- Author Card -->
        <div class="mt-8 flex flex-col sm:flex-row items-center sm:items-start gap-4 rounded-2xl border border-slate-200/80 bg-slate-50/50 p-6 dark:border-slate-800 dark:bg-slate-900/30">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-600 text-white font-bold text-lg shadow-md shadow-purple-500/20">
            JN
          </div>
          <div class="text-center sm:text-left">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">{post.data.author || 'Jasmin Nasit'}</h3>
            <p class="mt-1 text-xs text-purple-600 dark:text-purple-400 font-medium">Software Engineer & AI Systems Architect</p>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Writing deep technical dives on autonomous agents, neural retrieval architectures, LLM inference scaling, and production generative AI systems.
            </p>
          </div>
        </div>

        <!-- Previous & Next Article Navigation -->
        {
          (prevPost || nextPost) && (
            <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-slate-200 pt-8 dark:border-slate-800">
              {prevPost ? (
                <a
                  href={`${base}/blog/${prevPost.id}`}
                  class="group flex flex-col rounded-2xl border border-slate-200/80 bg-white p-4 transition hover:border-purple-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-purple-800"
                >
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 group-hover:text-purple-600 dark:group-hover:text-purple-400">← Previous</span>
                  <span class="mt-1 text-sm font-semibold text-slate-800 line-clamp-1 dark:text-slate-200">{prevPost.data.title}</span>
                </a>
              ) : <div />}

              {nextPost && (
                <a
                  href={`${base}/blog/${nextPost.id}`}
                  class="group flex flex-col rounded-2xl border border-slate-200/80 bg-white p-4 text-right transition hover:border-purple-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-purple-800 sm:items-end"
                >
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 group-hover:text-purple-600 dark:group-hover:text-purple-400">Next →</span>
                  <span class="mt-1 text-sm font-semibold text-slate-800 line-clamp-1 dark:text-slate-200">{nextPost.data.title}</span>
                </a>
              )}
            </div>
          )
        }
      </div>

      <!-- Sticky Table of Contents Sidebar -->
      <aside class="hidden lg:col-span-4 lg:block">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </article>

  <script>
    const copyBtn = document.getElementById('copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.textContent = 'Copy Link';
          }, 2000);
        } catch (e) {
          console.error('Failed to copy link:', e);
        }
      });
    }
  </script>
</BaseLayout>
