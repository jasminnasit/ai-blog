---
// FeaturedPost.astro
import TagBadge from './TagBadge.astro';

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
      category?: string;
      heroImage?: string;
      author?: string;
    };
  };
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(post.data.pubDate));

const heroImage = post.data.heroImage || 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?auto=format&fit=crop&w=1200&q=80';
---

<div class="relative overflow-hidden rounded-3xl border border-slate-200/80 bg-gradient-to-b from-white to-slate-50/50 shadow-xl shadow-purple-500/5 transition-all duration-300 hover:border-purple-300 hover:shadow-2xl hover:shadow-purple-500/10 dark:border-slate-800/80 dark:from-slate-900/80 dark:to-slate-950/80 dark:hover:border-purple-800/60">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 lg:gap-8 items-center">

    <!-- Image Column -->
    <a
      href={`${base}/blog/${post.id}`}
      class="group relative block aspect-[16/9] lg:aspect-auto lg:h-full w-full overflow-hidden bg-slate-100 lg:col-span-7 dark:bg-slate-800 min-h-[260px] sm:min-h-[340px]"
    >
      <img
        src={heroImage}
        alt={post.data.title}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent lg:hidden"></div>

      <!-- Featured Badge -->
      <div class="absolute top-4 left-4 flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-purple-600/90 px-3 py-1 text-xs font-semibold text-white shadow-lg backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple-200 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-white"></span>
          </span>
          Featured Article
        </span>
      </div>
    </a>

    <!-- Content Column -->
    <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10 lg:col-span-5">
      <!-- Category & Date -->
      <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500 dark:text-slate-400">
        {post.data.category && (
          <span class="font-semibold text-purple-600 dark:text-purple-400 uppercase tracking-wider text-[11px]">
            {post.data.category}
          </span>
        )}
        <span>•</span>
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      </div>

      <!-- Title -->
      <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 transition hover:text-purple-600 dark:text-white dark:hover:text-purple-400 sm:text-3xl">
        <a href={`${base}/blog/${post.id}`}>
          {post.data.title}
        </a>
      </h2>

      <!-- Description -->
      <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3">
        {post.data.description}
      </p>

      <!-- Tags & Read Button -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-5 dark:border-slate-800">
        <div class="flex flex-wrap gap-1.5">
          {post.data.tags.slice(0, 3).map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>

        <a
          href={`${base}/blog/${post.id}`}
          class="inline-flex items-center gap-2 rounded-xl bg-purple-600 px-4 py-2 text-xs sm:text-sm font-semibold text-white shadow-md shadow-purple-600/20 transition hover:bg-purple-700 hover:shadow-lg hover:shadow-purple-600/30"
        >
          Read Article
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
