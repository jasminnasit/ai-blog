---
// PostCard.astro
import TagBadge from './TagBadge.astro';

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
      category?: string;
      heroImage?: string;
      author?: string;
    };
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(post.data.pubDate));

// Fallback image if none specified
const heroImage = post.data.heroImage || 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?auto=format&fit=crop&w=800&q=80';
---

<article
  class={`group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-purple-300 hover:shadow-xl hover:shadow-purple-500/5 dark:border-slate-800/80 dark:bg-slate-900/60 dark:hover:border-purple-800/60 dark:hover:shadow-purple-950/20 ${
    featured ? 'md:grid md:grid-cols-2 md:gap-6' : ''
  }`}
>
  <!-- Card Image -->
  <a
    href={`${base}/blog/${post.id}`}
    class="relative block aspect-[16/9] w-full overflow-hidden bg-slate-100 dark:bg-slate-800"
  >
    <img
      src={heroImage}
      alt={post.data.title}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {
      post.data.category && (
        <span class="absolute top-3 left-3 rounded-md bg-slate-950/70 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-white backdrop-blur-md">
          {post.data.category}
        </span>
      )
    }
  </a>

  <!-- Card Body -->
  <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
    <div>
      <!-- Meta info: Date & Author -->
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span>{post.data.author || 'Jasmin Nasit'}</span>
      </div>

      <!-- Title -->
      <h3 class="mt-2.5 text-lg font-bold tracking-tight text-slate-900 transition-colors group-hover:text-purple-600 dark:text-slate-100 dark:group-hover:text-purple-400 sm:text-xl">
        <a href={`${base}/blog/${post.id}`}>
          {post.data.title}
        </a>
      </h3>

      <!-- Description -->
      <p class="mt-2 line-clamp-2 text-sm text-slate-600 dark:text-slate-400">
        {post.data.description}
      </p>
    </div>

    <!-- Tags & Read Link -->
    <div class="mt-5 flex items-center justify-between gap-2 border-t border-slate-100 pt-4 dark:border-slate-800/60">
      <div class="flex flex-wrap gap-1.5">
        {post.data.tags.slice(0, 2).map((tag) => (
          <TagBadge tag={tag} />
        ))}
      </div>

      <a
        href={`${base}/blog/${post.id}`}
        class="inline-flex items-center gap-1 text-xs font-semibold text-purple-600 group-hover:text-purple-700 dark:text-purple-400 dark:group-hover:text-purple-300"
      >
        Read article
        <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
