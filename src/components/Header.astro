---
// Header.astro
import ThemeToggle from './ThemeToggle.astro';
import SearchModal from './SearchModal.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '');

const navItems = [
  { name: 'Home', href: `${base}/` },
  { name: 'Articles', href: `${base}/blog` },
  { name: 'Topics', href: `${base}/tags` },
  { name: 'About', href: `${base}/about` },
];
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-950/80">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">

    <!-- Logo -->
    <a href={`${base}/`} class="group flex items-center gap-2.5 transition">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-tr from-purple-600 via-indigo-600 to-cyan-500 text-white shadow-md shadow-purple-500/25 transition group-hover:scale-105">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-base font-extrabold tracking-tight text-slate-900 dark:text-white">
          Nexus<span class="text-purple-600 dark:text-purple-400">.AI</span>
        </span>
        <span class="text-[10px] font-medium uppercase tracking-widest text-slate-400 dark:text-slate-500">Engineering Blog</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => {
          const isActive = pathname === item.href.replace(/\/$/, '') || (item.href !== `${base}/` && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`rounded-lg px-3.5 py-1.5 text-sm font-medium transition-colors ${
                isActive
                  ? 'bg-slate-100 text-purple-600 dark:bg-slate-900 dark:text-purple-400'
                  : 'text-slate-600 hover:bg-slate-100/80 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-900/80 dark:hover:text-slate-200'
              }`}
            >
              {item.name}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls: Search, Theme Toggle, GitHub -->
    <div class="flex items-center gap-2.5">
      <SearchModal />
      <ThemeToggle />

      <!-- GitHub Link -->
      <a
        href="https://github.com/jasminnasit/ai-blog"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Repository"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
      </a>
    </div>
  </div>
</header>
