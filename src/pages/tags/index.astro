---
// src/pages/tags/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const tagCounts = allPosts.reduce((acc: Record<string, number>, post) => {
  post.data.tags.forEach((tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout
  title="Browse Topics & Research Tags | Nexus AI"
  description="Explore technical articles, guides, and engineering benchmarks categorized across AI agents, neural retrieval, LLM architectures, and systems."
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <!-- Header -->
    <header class="mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-purple-200/80 bg-purple-50/80 px-3 py-0.5 text-xs font-semibold text-purple-700 dark:border-purple-800/80 dark:bg-purple-950/40 dark:text-purple-300">
        Topic Taxonomy
      </div>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Explore by Research Tag
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300">
        Browse our comprehensive library of technical articles grouped by specialized artificial intelligence concepts and tools.
      </p>
    </header>

    <!-- Tag Cloud Grid -->
    <div class="rounded-3xl border border-slate-200/80 bg-white/70 p-6 sm:p-10 shadow-sm backdrop-blur-sm dark:border-slate-800/80 dark:bg-slate-900/40">
      <div class="flex flex-wrap items-center justify-center gap-3">
        {
          sortedTags.map(([tag, count]) => (
            <TagBadge tag={tag} count={count} size="md" />
          ))
        }
      </div>
    </div>

    <!-- Back to blog link -->
    <div class="mt-10 text-center">
      <a
        href={`${base}/blog`}
        class="inline-flex items-center gap-2 text-sm font-semibold text-purple-600 hover:text-purple-700 dark:text-purple-400 dark:hover:text-purple-300"
      >
        ← View all research articles
      </a>
    </div>
  </div>
</BaseLayout>
