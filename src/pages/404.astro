---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Page Not Found (404) | Nexus AI"
  description="The requested page or AI research paper could not be found."
>
  <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24 text-center">
    <div class="inline-flex h-20 w-20 items-center justify-center rounded-3xl bg-purple-100 text-3xl font-extrabold text-purple-700 shadow-inner dark:bg-purple-950/60 dark:text-purple-300">
      404
    </div>

    <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      Hyperspace Anomaly Detected
    </h1>

    <p class="mt-4 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
      The research article, topic path, or resource you are seeking has been moved, archived, or does not exist in the current latent space.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`${base}/`}
        class="inline-flex items-center gap-2 rounded-xl bg-purple-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-purple-600/25 transition hover:bg-purple-700 hover:shadow-xl hover:shadow-purple-600/35"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Return to Home
      </a>

      <a
        href={`${base}/blog`}
        class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        Browse All Articles
      </a>
    </div>
  </div>
</BaseLayout>
