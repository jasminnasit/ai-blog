---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const focusAreas = [
  {
    title: 'Autonomous Agent Workflows',
    description:
      'Designing self-healing, multi-step agent orchestrations using state machines, reflective reasoning, and dynamic tool calling in production environments.',
    icon: '🤖',
  },
  {
    title: 'Neural Retrieval & Graph RAG',
    description:
      'Advancing beyond naive dense embedding lookups with hybrid BM25 + dense reranking, knowledge graph synthesis, and context-aware chunking.',
    icon: '🔍',
  },
  {
    title: 'Inference-Time Compute & Reasoning',
    description:
      'Exploring test-time compute scaling, tree-of-thought search mechanisms, verification-guided generation, and speculative decoding techniques.',
    icon: '⚡',
  },
  {
    title: 'Production LLM Systems & Serving',
    description:
      'Optimizing vLLM throughput, KV cache quantization (FP8/INT4), continuous batching, and latency SLA guarantees for enterprise scale.',
    icon: '🏗️',
  },
];

const principles = [
  {
    number: '01',
    title: 'Rigorous Empirical Benchmarking',
    description:
      'We test architectures under real-world stress loads and adversarial edge cases rather than relying solely on synthetic benchmarks.',
  },
  {
    number: '02',
    title: 'Zero Hype, Pure Engineering',
    description:
      'Every technical article provides architectural diagrams, reproducible code repositories, and actionable tradeoff discussions.',
  },
  {
    number: '03',
    title: 'Open Source & Accessible Research',
    description:
      'We believe the future of artificial intelligence should be transparent, democratized, and openly documented for all developers.',
  },
];
---

<BaseLayout
  title="About Nexus AI — Mission, Research & Systems Engineering"
  description="Learn about Nexus AI, our technical focus on autonomous agents, neural retrieval optimization, and production LLM infrastructure."
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-16 lg:px-8">
    <!-- Header -->
    <header class="text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-purple-200/80 bg-purple-50/80 px-3.5 py-1 text-xs font-semibold text-purple-700 shadow-sm backdrop-blur-sm dark:border-purple-800/80 dark:bg-purple-950/40 dark:text-purple-300">
        Our Mission & Architecture
      </div>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Demystifying Modern <span class="bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 bg-clip-text text-transparent">AI Systems</span>
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        Nexus AI is an open engineering publication dedicated to sharing deep technical insights, reproducible architectures, and benchmarks in generative AI, autonomous agent design, and scalable inference infrastructure.
      </p>
    </header>

    <!-- Mission Statement Block -->
    <section class="mt-14 rounded-3xl border border-slate-200/80 bg-white/70 p-8 shadow-sm backdrop-blur-sm dark:border-slate-800/80 dark:bg-slate-900/40 sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        Why Nexus AI Exists
      </h2>
      <div class="mt-4 space-y-4 text-base leading-relaxed text-slate-600 dark:text-slate-300">
        <p>
          The artificial intelligence landscape is evolving at a breakneck pace. While high-level announcements and marketing claims dominate the headlines, engineering teams in the trenches often lack rigorous, deep-dive technical resources on what truly works in production.
        </p>
        <p>
          Nexus AI bridges that gap. We focus on low-level system design, memory management, latency optimization, and robust architectural patterns that turn raw foundation models into production-ready software systems.
        </p>
      </div>
    </section>

    <!-- Core Research Pillars -->
    <section class="mt-16">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
          Core Research & Engineering Tracks
        </h2>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          The four key architectural frontiers we actively investigate and write about.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          focusAreas.map((area) => (
            <div class="group rounded-2xl border border-slate-200/80 bg-white/60 p-6 shadow-sm transition hover:border-purple-300 hover:shadow-md dark:border-slate-800/80 dark:bg-slate-900/40 dark:hover:border-purple-700/60">
              <div class="text-3xl mb-4">{area.icon}</div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition">
                {area.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {area.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Guiding Principles -->
    <section class="mt-16">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
          Our Editorial & Research Principles
        </h2>
      </div>

      <div class="space-y-6">
        {
          principles.map((item) => (
            <div class="flex flex-col sm:flex-row items-start gap-4 rounded-2xl border border-slate-200/80 bg-white/60 p-6 shadow-sm dark:border-slate-800/80 dark:bg-slate-900/40">
              <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-purple-100 font-mono text-sm font-bold text-purple-700 dark:bg-purple-950/60 dark:text-purple-300">
                {item.number}
              </span>
              <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                  {item.title}
                </h3>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Connect / Call to Action -->
    <section class="mt-16 rounded-3xl border border-purple-200/80 bg-gradient-to-tr from-purple-500/10 via-indigo-500/10 to-transparent p-8 text-center sm:p-12 dark:border-purple-800/60 dark:from-purple-950/40 dark:via-indigo-950/40">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
        Collaborate & Contribute
      </h2>
      <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300 max-w-xl mx-auto">
        Have benchmark data, architectural proposals, or open-source research you’d like to share? Connect with us on GitHub and help shape the next era of AI engineering.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={`${base}/blog`}
          class="inline-flex items-center gap-2 rounded-xl bg-purple-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-purple-600/25 transition hover:bg-purple-700"
        >
          Read Our Articles
        </a>
        <a
          href="https://github.com/jasminnasit"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          GitHub Profile
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
