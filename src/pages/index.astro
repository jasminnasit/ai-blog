---
// index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import TagBadge from '../components/TagBadge.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch all non-draft posts, sorted by newest date first
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = allPosts.find((post) => post.data.featured) || allPosts[0];
const recentPosts = allPosts.filter((post) => post.id !== featuredPost?.id).slice(0, 6);

// Extract unique tags and compute count
const tagCounts = allPosts.reduce((acc: Record<string, number>, post) => {
  post.data.tags.forEach((tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {});

const popularTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);
---

<BaseLayout
  title="Nexus AI — Advanced AI Systems, Autonomous Agents & RAG Engineering"
  description="Open engineering insights, autonomous agent architectures, RAG optimization, and AI systems research written by developers, for developers."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">

    <!-- Hero Section -->
    <section class="relative py-8 sm:py-16 text-center max-w-3xl mx-auto">
      <!-- Gradient Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-purple-200/80 bg-purple-50/80 px-3.5 py-1 text-xs font-semibold text-purple-700 shadow-sm backdrop-blur-sm dark:border-purple-800/80 dark:bg-purple-950/40 dark:text-purple-300">
        <span class="flex h-2 w-2 rounded-full bg-purple-500 animate-pulse"></span>
        Deep AI Engineering & Systems Research
      </div>

      <!-- Main Headline -->
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl leading-[1.15]">
        Building the Next Generation of <span class="bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 bg-clip-text text-transparent">Intelligent Systems</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Deep dives into autonomous agent architectures, neural retrieval optimization, inference-time compute scaling, and production-grade generative AI workflows.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        <a
          href={`${base}/blog`}
          class="inline-flex items-center gap-2 rounded-xl bg-purple-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-purple-600/25 transition hover:bg-purple-700 hover:shadow-xl hover:shadow-purple-600/35"
        >
          Explore All Articles
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="https://github.com/jasminnasit/ai-blog"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          Star on GitHub
        </a>
      </div>
    </section>

    <!-- Popular Topics Cloud -->
    <section class="mt-4 mb-12 flex flex-wrap items-center justify-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mr-2">Hot Topics:</span>
      {
        popularTags.map(([tag, count]) => (
          <TagBadge tag={tag} count={count} />
        ))
      }
    </section>

    <!-- Featured Post Showcase -->
    {
      featuredPost && (
        <section class="mb-16">
          <div class="mb-6 flex items-center justify-between">
            <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-2xl">
              Spotlight Story
            </h2>
          </div>
          <FeaturedPost post={featuredPost} />
        </section>
      )
    }

    <!-- Recent Posts Grid -->
    <section class="mb-16">
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-2xl">
            Latest Research & Guides
          </h2>
          <p class="mt-1 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            Freshly published engineering articles and architectural benchmarks.
          </p>
        </div>

        <a
          href={`${base}/blog`}
          class="hidden sm:inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-purple-600 hover:text-purple-700 dark:text-purple-400 dark:hover:text-purple-300"
        >
          View all {allPosts.length} articles →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {
          recentPosts.map((post) => (
            <PostCard post={post} />
          ))
        }
      </div>

      <div class="mt-10 text-center sm:hidden">
        <a
          href={`${base}/blog`}
          class="inline-flex items-center justify-center w-full rounded-xl border border-slate-200 bg-white py-3 text-sm font-semibold text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"
        >
          View all {allPosts.length} articles →
        </a>
      </div>
    </section>

    <!-- Newsletter & Updates Section -->
    <section class="relative overflow-hidden rounded-3xl border border-purple-200/80 bg-gradient-to-tr from-purple-500/10 via-indigo-500/10 to-transparent p-8 sm:p-12 text-center dark:border-purple-800/60 dark:from-purple-950/40 dark:via-indigo-950/40">
      <div class="max-w-2xl mx-auto">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-purple-600 text-white shadow-lg shadow-purple-600/30 mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Stay Ahead of the AI Frontier
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Subscribe to our RSS feed or star the GitHub repository for instant notifications when new technical deep dives are released.
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href={`${base}/rss.xml`}
            class="inline-flex items-center gap-2 rounded-xl bg-amber-500 px-5 py-2.5 text-xs sm:text-sm font-semibold text-white shadow-md transition hover:bg-amber-600"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
            </svg>
            Subscribe via RSS
          </a>
          <a
            href="https://github.com/jasminnasit"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-xs sm:text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            Follow on GitHub
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
