---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch all non-draft posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect unique categories & tags
const categories = Array.from(
  new Set(allPosts.map((post) => post.data.category).filter(Boolean))
) as string[];

const tagCounts = allPosts.reduce((acc: Record<string, number>, post) => {
  post.data.tags.forEach((tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {});

const popularTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<BaseLayout
  title="All Articles & Research Papers | Nexus AI"
  description="Explore the complete archive of technical deep dives, autonomous agent architectures, and LLM systems benchmarks."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">

    <!-- Header -->
    <header class="mb-10 max-w-2xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-purple-200/80 bg-purple-50/80 px-3 py-0.5 text-xs font-semibold text-purple-700 dark:border-purple-800/80 dark:bg-purple-950/40 dark:text-purple-300">
        Articles Archive
      </div>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        All Research & Engineering Guides
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300">
        In-depth technical papers, benchmark analysis, and production patterns for modern AI stacks.
      </p>
    </header>

    <!-- Tag Cloud Filters -->
    <div class="mb-10 flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200/80 bg-white/60 p-4 backdrop-blur-sm dark:border-slate-800/80 dark:bg-slate-900/40">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mr-2">
        Filter Topics:
      </span>
      <a
        href={`${base}/blog`}
        class="inline-flex items-center rounded-lg bg-purple-600 px-3 py-1 text-xs font-medium text-white shadow-sm"
      >
        All ({allPosts.length})
      </a>
      {
        popularTags.map(([tag, count]) => (
          <TagBadge tag={tag} count={count} />
        ))
      }
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {
        allPosts.map((post) => (
          <PostCard post={post} />
        ))
      }
    </div>

  </div>
</BaseLayout>
